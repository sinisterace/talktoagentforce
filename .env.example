# Copy to .env for local development (Heroku: set these as config vars).

# ElevenLabs text-to-speech (server-side only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=UgBBYS2sOqTuMpoF3BR0
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Salesforce MIAW (served to the browser by /api/config; mints anonymous guest tokens only)
SF_SCRT2_URL=https://your-domain.my.salesforce-scrt.com
SF_ORG_ID=00Dxx0000000000          # 15-character org id
SF_MIAW_APP_NAME=heroku_demo

# Optional: transcript logging via the Voice_Demo_Logger connected app (client credentials).
# Leave all three unset to disable logging.
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Optional: extra origins allowed to call /api/tts (comma-separated)
ALLOWED_ORIGINS=
